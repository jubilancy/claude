    },
    {
      "type": "text",
      "text": "Howard Pyle American",
      "formatting": [
        {
          "type": "link",
          "start": 0,
          "end": 11,
          "url": "https://www.metmuseum.org/art/collection/search?artist=Howard+Pyle"
